from policy: base_amount, items_total, capped, floor_cap

page Policy
  save price, quantity = 0
  save item1, item2, item3, item4 = 0
  save total, floor, cap = 0
  capped_result, floor_cap_result = 0

  ask price "단가"
  ask quantity "수량"
  button "기본 금액 계산" -> total = base_amount(price, quantity)

  ask item1 "항목 1"
  ask item2 "항목 2"
  ask item3 "항목 3"
  ask item4 "항목 4"
  button "네 항목 합계" -> total = items_total(item1, item2, item3, item4)

  ask total "합계"
  ask floor "하한"
  ask cap "상한"

  show capped_result
  show floor_cap_result
  button "상한 정책 적용" -> capped_result = capped(total, cap)
  button "최소 비용 정책 적용" -> floor_cap_result = floor_cap(total, floor, cap)
