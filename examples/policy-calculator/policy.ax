# Price times quantity.
base_amount(price, quantity)
  need price <= 10000
  need quantity <= 100

  -> price * quantity

# Sum of four items.
items_total(a, b, c, d)
  need a <= 250000
  need b <= 250000
  need c <= 250000
  need d <= 250000

  -> a + b + c + d

# Never go above the cap.
capped(total, cap)
  need total <= 1000000
  need cap <= 1000000

  total > cap -> cap
  -> total

# Keep the total between floor and cap.
floor_cap(total, floor, cap)
  need total <= 1000000
  need floor <= cap
  need cap <= 1000000

  total < floor -> floor
  total > cap -> cap
  -> total
