{
  "scopeName": "source.axiom",
  "name": "Axiom",
  "patterns": [
    {
      "name": "comment.line.double-slash.axiom",
      "match": "//.*$"
    },
    {
      "name": "keyword.control.axiom",
      "match": "\\b(import|export|from|contract|program|fn|extern|return|requires|when|ensures|gives|if|else|let|in|page|record|component|use|state|show|button|updates|adds|runs|reducer|input|placeholder|persist|list|as|with)\\b"
    },
    {
      "name": "storage.type.axiom",
      "match": "\\b(u32|i32|number|bool|text)\\b"
    },
    {
      "name": "constant.numeric.axiom",
      "match": "\\b\\d+\\b"
    },
    {
      "name": "keyword.operator.axiom",
      "match": "(-%|\\*%|\\+%|<<|==|!=|<=|>=|<|>|->|&|\\||\\^|plus|minus|times|shift_left|equals|not_equals|is_not|and|or)"
    },
    {
      "name": "variable.language.result.axiom",
      "match": "\\b(result|answer)\\b"
    }
  ]
}
