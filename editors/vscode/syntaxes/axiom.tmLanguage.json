{
  "scopeName": "source.axiom",
  "name": "Axiom",
  "patterns": [
    {
      "name": "comment.line.double-slash.axiom",
      "match": "//.*$"
    },
    {
      "name": "keyword.control.axiom",
      "match": "\\b(import|export|from|contract|program|requires|when|ensures|gives|if|else|let|in|page|state|show|button|updates|with)\\b"
    },
    {
      "name": "storage.type.axiom",
      "match": "\\b(u32|number|bool)\\b"
    },
    {
      "name": "constant.numeric.axiom",
      "match": "\\b\\d+\\b"
    },
    {
      "name": "keyword.operator.axiom",
      "match": "(\\*%|\\+%|<<|==|!=|<=|>=|<|>|->|plus|times|shift_left|equals|not_equals|is_not|and|or)"
    },
    {
      "name": "variable.language.result.axiom",
      "match": "\\b(result|answer)\\b"
    }
  ]
}
