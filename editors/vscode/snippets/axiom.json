{
  "rule": {
    "prefix": "rule",
    "body": [
      "${1:name}(${2:x})",
      "  need ${2} <= ${3:1000}",
      "",
      "  ${4:condition} -> ${5:value}",
      "  -> ${6:value}"
    ],
    "description": "A rule: need lines, condition -> value lines, and a final -> value"
  },
  "need": {
    "prefix": "need",
    "body": "need ${1:x} <= ${2:1000}",
    "description": "Only accept inputs that meet this"
  },
  "case": {
    "prefix": "->",
    "body": "${1:condition} -> ${2:value}",
    "description": "If the condition holds, this value is the answer"
  },
  "page": {
    "prefix": "page",
    "body": [
      "from ${1:logic}: ${2:rule}",
      "",
      "page ${3:Main}",
      "  save ${4:a} = 0",
      "  result = 0",
      "",
      "  ask ${4} \"${5:A}\"",
      "  show result",
      "  button \"${6:Go}\" -> result = ${2}(${4})"
    ],
    "description": "A page that uses a rule"
  },
  "button": {
    "prefix": "button",
    "body": "button \"${1:Label}\" -> ${2:target} = ${3:rule}(${4})",
    "description": "On click, set a value to a rule's answer"
  },
  "ask": {
    "prefix": "ask",
    "body": "ask ${1:name} \"${2:Label}\"",
    "description": "An input box"
  }
}
